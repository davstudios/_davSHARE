{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "_davSHARE",
  "version": "26.10.2",
  "identifier": "studio.dav.share",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:17462",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "_davSHARE",
        "width": 1420,
        "height": 880,
        "minWidth": 980,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "dragDropEnabled": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; img-src 'self' asset: data:; style-src 'self' 'unsafe-inline'; font-src 'self' https://fonts.gstatic.com; script-src 'self'; connect-src ipc: http://ipc.localhost"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Productivity",
    "shortDescription": "Local file sharing over your LAN",
    "longDescription": "_davSHARE shares files between desktop and mobile devices on the same local network using temporary QR sessions and no cloud storage.",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.ico",
      "icons/icon.icns"
    ],
    "macOS": {
      "signingIdentity": "-"
    },
    "publisher": "_davstudios",
    "homepage": "https://davstudios.it",
    "copyright": "© 2026 _davstudios",
    "license": "MIT",
    "licenseFile": "../LICENSE",
    "linux": {
      "deb": {
        "section": "utils",
        "priority": "optional"
      }
    }
  }
}
